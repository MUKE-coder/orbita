# Build outputs. Root-anchored so they don't match the cmd/orbita/ source tree
# or the cmd/orbita/internal/orbita package dir.
/orbita
/orbita.exe
/orbita-server
/orbita-server.exe
/grit
/grit.exe
*.exe
*.dll
*.so
*.dylib

# Environment
.env

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Go
vendor/
*.test
*.out
coverage.txt

# Frontend
web/node_modules/
# Ignore built SPA output but keep a placeholder so `//go:embed all:web/dist`
# compiles in CI without a frontend build. (Ignore contents, not the dir, so the
# negation can re-include the placeholder.)
web/dist/*
!web/dist/.gitkeep

# Air
tmp/

# Local dev artifacts (Grit Cloud)
.local/
orbita-dev.exe
orbita-dev.exe~
